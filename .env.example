# Set the real public origin before launch. Local preview is intentionally noindex.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Keep demo events labeled, excluded from Event JSON-LD and noindex until replaced.
NEXT_PUBLIC_DEMO_MODE=true
# Production: use webhook, or file only on a host with a persistent disk.
FORM_STORAGE=file
FORM_DATA_DIR=.data
# FORM_WEBHOOK_URL=https://your-server.example/submissions
# FORM_WEBHOOK_TOKEN=
# TRUST_PROXY=false
